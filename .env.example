# ---------------------------------------------------------------------------
# VERA environment template.
# Copy to `.env.local` (or `.env`) and fill in values. NEVER commit real secrets.
# Every variable below is optional unless marked REQUIRED — see
# docs/operations/LOCAL_SETUP.md for the minimal local configuration.
# ---------------------------------------------------------------------------

# --- Core (REQUIRED) -------------------------------------------------------
# Node.js runtime URL of this app (used for auth redirects and links).
APP_URL=http://localhost:3000
# PostgreSQL connection string.
# Local (npm run db:start):  postgresql://postgres:postgres@127.0.0.1:5432/vera?schema=public
# Neon:                       postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vera?schema=public

# --- Better Auth (REQUIRED) ------------------------------------------------
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth (OPTIONAL — sign-in stays disabled until both are set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (OPTIONAL) ------------------------------------------------------
# Delivery mode: dev (default; writes to .local/outbox, NOT delivered)
#                resend | smtp
EMAIL_DELIVERY=dev
# Resend (https://resend.com) — requires a verified sender domain in production.
RESEND_API_KEY=
EMAIL_FROM="VERA <no-reply@vera.example>"
# SMTP (Mailpit for local capture: docker compose up mailpit → localhost:1025)
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Address that receives the dev outbox copy when EMAIL_DELIVERY=dev.
DEV_OUTBOX_DIR=.local/outbox

# --- Object storage (OPTIONAL) --------------------------------------------
# local (default) | s3 (Cloudflare R2, MinIO, AWS S3 compatible)
STORAGE_PROVIDER=local
# Local provider root directory
STORAGE_DIR=.local/storage
# S3 / R2 / MinIO settings (only when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=vera
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for R2/MinIO path-style addressing (usually true for MinIO/R2)
S3_FORCE_PATH_STYLE=true
# Presigned URL lifetime (seconds)
S3_PRESIGN_EXPIRES=300

# --- Uploads & quotas ------------------------------------------------------
MAX_UPLOAD_BYTES=104857600        # 100 MB per file
DEFAULT_STORAGE_QUOTA_BYTES=10737418240  # 10 GB per user

# --- Malware scanning (OPTIONAL — see docs/integration/EXTERNAL_SERVICES.md)
# When unset, files pass static content validation only and the AV integration
# is reported as BLOCKED (files are never marked "scanned by antivirus").
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Rate limiting ---------------------------------------------------------
# db (default, atomic PostgreSQL) | upstash | memory (single-process dev only)
RATE_LIMIT_DRIVER=db
# Upstash Redis REST (https://upstash.com) — only when RATE_LIMIT_DRIVER=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anti-bot (OPTIONAL, risk-sensitive public forms only) ------------------
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Background worker -----------------------------------------------------
# inline: attempt delivery inline (default) and record durable outbox entries
# queue : only enqueue; requires `npm run worker` to make progress
EMAIL_DELIVERY_MODE=inline
WORKER_POLL_INTERVAL_MS=2000

# --- Observability ---------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Set to 1 to expose /readyz details (never enable in production)
EXPOSE_HEALTH_DETAILS=0

# --- Feature switches (Phase gates) ---------------------------------------
# AI generation stays disabled through Phase 2.
AI_ENABLED=0
# Rewards earning/redemption stays disabled through Phase 4.
REWARDS_ENABLED=0
